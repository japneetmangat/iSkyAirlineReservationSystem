<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="se2203b.assignments.controller.AddNewFlightController"
      spacing="16" prefWidth="430" prefHeight="420">

    <padding><Insets top="20" left="30" right="30" bottom="20"/></padding>

    <Label text="Add New Airline Flight"
           style="-fx-font-size: 14px; -fx-font-weight: bold;"
           maxWidth="Infinity" alignment="CENTER" />

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Flight Number" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtFlightNumber" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Origin" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtOrigin" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Destination" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtDestination" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Departure Time" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtDepartureTime" promptText="H:mm  (e.g. 11:10)"
                   GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Arrival Time" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="txtArrivalTime" promptText="H:mm  (e.g. 18:30)"
                   GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="Launch Date" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <DatePicker fx:id="dpLaunchDate" GridPane.columnIndex="1" GridPane.rowIndex="5"
                    maxWidth="Infinity" />
    </GridPane>

    <Label fx:id="lblStatus" style="-fx-text-fill: red;" wrapText="true" />

    <Region VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Cancel" onAction="#handleCancel" />
        <Button text="Save"   onAction="#handleSave"
                style="-fx-background-color: #e8e8e8;" />
    </HBox>

</VBox>
